{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileId", "management"],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1,
      "description": "发布档标识（写进关于页，便于售后定位）"
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverUrl"],
      "properties": {
        "serverUrl": {
          "type": "string",
          "minLength": 1,
          "description": "服务端 API 基址（构建期编译进安装包；dev 可用 http://127.0.0.1）"
        },
        "allowDevServerOverride": {
          "type": "boolean",
          "description": "仅 dev：渲染层/设置是否可覆盖服务端地址"
        },
        "updateUrl": {
          "type": ["string", "null"],
          "description": "自动更新检查源：GET 该地址返回 latest.json"
        }
      }
    }
  }
}
